import sys
import os
import json
from datetime import datetime, timedelta
from PyQt5.QtWidgets import (
    QApplication, QWidget, QVBoxLayout, QLabel, QPushButton,
    QCheckBox, QMessageBox
)
from PyQt5.QtCore import Qt, QTimer, QTime, QDate
from PyQt5.QtGui import QFont

class TaskReminder(QWidget):
    def __init__(self):
        super().__init__()

        self.task_file = "task_status.json"
        self.tasks = [
            "Finish Python project",
            "Read 30 pages",
            "Exercise for 30 min",
            "Meditate"
        ]
        self.checkboxes = []

        self.today_str = QDate.currentDate().toString("yyyy-MM-dd")
        self.load_task_data()

        self.setWindowTitle("🚀 High-Tech Task Reminder")
        self.setGeometry(500, 200, 400, 400)
        self.setWindowFlags(Qt.WindowStaysOnTopHint)
        self.setAttribute(Qt.WA_TranslucentBackground)

        self.initUI()
        self.check_if_submitted()

    def initUI(self):
        layout = QVBoxLayout()

        # Title
        title = QLabel("🌌 Today's Tasks")
        title.setFont(QFont("Orbitron", 18, QFont.Bold))
        title.setStyleSheet("color: #00ffff; text-shadow: 0 0 8px #00ffff;")
        title.setAlignment(Qt.AlignCenter)
        layout.addWidget(title)

        # Date and Countdown Clock
        self.date_label = QLabel()
        self.clock_label = QLabel()
        self.date_label.setStyleSheet("color: #00ffff; font-size: 12pt;")
        self.clock_label.setStyleSheet("color: #00ffff; font-size: 14pt; font-weight: bold;")
        layout.addWidget(self.date_label)
        layout.addWidget(self.clock_label)
        self.update_clock()
        self.timer = QTimer()
        self.timer.timeout.connect(self.update_clock)
        self.timer.start(1000)

        # Tasks
        for i, task in enumerate(self.tasks):
            cb = QCheckBox(task)
            cb.setStyleSheet("""
                QCheckBox {
                    color: #00ffff;
                    font-size: 14pt;
                }
                QCheckBox::indicator {
                    width: 24px;
                    height: 24px;
                }
                QCheckBox::indicator:unchecked {
                    border: 2px solid #00ffff;
                    border-radius: 12px;
                    background: transparent;
                }
                QCheckBox::indicator:checked {
                    background-color: #00ffff;
                    border-radius: 12px;
                }
            """)
            cb.stateChanged.connect(self.lock_checkbox)
            cb.setChecked(self.task_data.get("tasks", {}).get(task, False))
            layout.addWidget(cb)
            self.checkboxes.append(cb)

        # Submit button
        submit_btn = QPushButton("✅ Complete and Close")
        submit_btn.setStyleSheet("""
            QPushButton {
                background-color: #00ffff;
                border-radius: 12px;
                padding: 10px;
                font-size: 14pt;
                color: black;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #00dddd;
            }
        """)
        submit_btn.clicked.connect(self.submit_tasks)
        layout.addWidget(submit_btn)

        self.setLayout(layout)

    def update_clock(self):
        now = QTime.currentTime()
        midnight = QTime(23, 59, 59)
        remaining = QTime(0, 0).secsTo(midnight) - now.secsTo(QTime(0, 0))
        self.date_label.setText("📅 Date: " + self.today_str)
        self.clock_label.setText(f"⏳ Time left today: {str(timedelta(seconds=remaining))}")

    def lock_checkbox(self):
        sender = self.sender()
        if sender.isChecked():
            sender.setEnabled(False)
            self.save_task_state()

    def save_task_state(self):
        task_status = {cb.text(): cb.isChecked() for cb in self.checkboxes}
        with open(self.task_file, 'w') as f:
            json.dump({
                "date": self.today_str,
                "tasks": task_status,
                "submitted": all(task_status.values())
            }, f)

    def load_task_data(self):
        if os.path.exists(self.task_file):
            with open(self.task_file, 'r') as f:
                data = json.load(f)
            if data.get("date") == self.today_str:
                self.task_data = data
            else:
                self.task_data = {"date": self.today_str, "tasks": {}, "submitted": False}
        else:
            self.task_data = {"date": self.today_str, "tasks": {}, "submitted": False}

    def check_if_submitted(self):
        if self.task_data.get("submitted"):
            QMessageBox.information(self, "✅ Already Done", "You've already completed all tasks today!")
            QTimer.singleShot(2000, self.close)

    def submit_tasks(self):
        if all(cb.isChecked() for cb in self.checkboxes):
            for cb in self.checkboxes:
                cb.setEnabled(False)
            self.task_data["submitted"] = True
            self.save_task_state()
            QMessageBox.information(self, "✅ Done", "All tasks completed. Good job!")
            self.close()
        else:
            QMessageBox.warning(self, "❌ Incomplete", "Please complete all tasks first.")

    def closeEvent(self, event):
        if not all(cb.isChecked() for cb in self.checkboxes):
            event.ignore()
            QMessageBox.warning(self, "❌ Can't Close", "You must complete all tasks to close this app.")
        else:
            event.accept()

if __name__ == "__main__":
    # Check if today's task is already submitted
    task_file = "task_status.json"
    today_str = QDate.currentDate().toString("yyyy-MM-dd")
    if os.path.exists(task_file):
        with open(task_file, 'r') as f:
            data = json.load(f)
        if data.get("date") == today_str and data.get("submitted"):
            sys.exit()  # Don't show app if today's task already done

    app = QApplication(sys.argv)
    window = TaskReminder()
    window.show()
    sys.exit(app.exec_())
